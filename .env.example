# Copy this file to .env.local. Use the SAME project as the main CodeSquad site.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Existing CodeSquad variable names also work, if using a legacy service-role key:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional comma-separated slugs of published studies relevant across industries.
# Original category labels remain visible; unpublished studies are always excluded.
CASE_STUDY_INCLUDE_SLUGS=
